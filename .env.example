# Copia este archivo como .env y rellena los valores.

# --- Obligatorias ---
# Token del bot, creado con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
# API key de Anthropic: https://platform.claude.com → API keys
ANTHROPIC_API_KEY=

# --- Opcionales (valor por defecto entre paréntesis) ---
# Modelo de Claude (claude-sonnet-5-5)
CLINICA_MODEL=
# Esfuerzo de razonamiento: low | medium | high (low)
CLINICA_EFFORT=
# Remitente de los emails; si se deja vacío, se usa la cuenta autorizada de Gmail
GMAIL_FROM=
# Puerto del servidor MCP (3333)
MCP_PORT=
# Ruta de la base de datos SQLite (data/clinica.db)
CLINICA_DB=
