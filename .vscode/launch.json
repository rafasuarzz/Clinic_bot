{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Servidor MCP",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/mcp_server.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python"
    },
    {
      "name": "Bot de Telegram",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/telegram_bot.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/bin/python"
    }
  ],
  "compounds": [
    {
      "name": "Servidor + Bot",
      "configurations": [
        "Servidor MCP",
        "Bot de Telegram"
      ],
      "stopAll": true
    }
  ]
}
